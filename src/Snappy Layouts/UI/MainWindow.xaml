<Window x:Class="SnappyLayout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snappy Layouts"
        Width="1220" Height="820"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SOL KENAR ÇUBUĞU (UNIFIED COLLAPSIBLE SIDEBAR) ==================== -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,14,12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Başlık + Versiyon + Daraltma Düğmesi (Logo X,Y asla değişmez) -->
                <Grid Grid.Row="0" Margin="0,0,0,14" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource BrandGradientBrush}"
                            Cursor="Hand" MouseLeftButtonDown="OnToggleSidebarClick"
                            ToolTip="Expand / Collapse Sidebar">
                        <TextBlock Text="⊞" FontSize="21" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="SidebarBrandText" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                        <TextBlock Text="Snappy Layouts" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarStatusText" Text="Active" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PermanentBrush}"/>
                            <Border Background="{DynamicResource NavWorkspacesBgBrush}"
                                    BorderBrush="{DynamicResource NavWorkspacesBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarVersionText" Text="v0.1" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource NavWorkspacesBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnToggleSidebar" Grid.Column="2" Content="☰" Click="OnToggleSidebarClick"
                            Padding="6,4" FontSize="13" VerticalAlignment="Center" ToolTip="Collapse / Expand Menu"/>
                </Grid>

                <!-- Sekme Düğmeleri (İkon koordinatları ve satır yükseklikleri her iki modda %100 sabit) -->
                <StackPanel Grid.Row="1" x:Name="NavButtonsPanel">
                    <Button x:Name="BtnNavLayouts" Click="OnNavClick" Tag="0" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavVirtual" Click="OnNavClick" Tag="1" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavWorkspaces" Click="OnNavClick" Tag="2" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavHotkeys" Click="OnNavClick" Tag="3" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavSettings" Click="OnNavClick" Tag="4" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavHelp" Click="OnNavClick" Tag="5" Height="46"
                            HorizontalContentAlignment="Stretch" Padding="9,6,9,6" Margin="0,0,0,6" FontSize="13"/>
                </StackPanel>

                <!-- Alt Kontroller: Expand ve Collapse modunda AYNI yapı (sadece metin/combobox açılıp kapanır) -->
                <Border x:Name="SidebarFooterCard" Grid.Row="2"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="5,8,5,8">
                    <StackPanel>
                        <!-- 1) Dil Satırı: Aktif dilin bayrağı (tıklanabilir) + ComboBox -->
                        <Grid Margin="0,0,0,6" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnFooterLangIcon" Grid.Column="0" Click="OnFooterLangIconClick"
                                    Width="36" Height="30" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="QuickLangCombo" SelectionChanged="OnQuickLangChanged"
                                      FontSize="11.5" Padding="6,3" Margin="4,0,3,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 2) Tema Satırı: Aktif tema ikonu (tıklanabilir) + ComboBox -->
                        <Grid Margin="0,0,0,8" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnFooterThemeIcon" Grid.Column="0" Click="OnFooterThemeIconClick"
                                    Width="36" Height="30" Padding="0" FontSize="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="QuickThemeCombo" SelectionChanged="OnQuickThemeChanged"
                                      FontSize="11.5" Padding="6,3" Margin="4,0,3,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 3) Sınır Çizgilerini Göster -->
                        <Button x:Name="BtnQuickShowBorders" Click="OnQuickShowBorders" Height="34"
                                Padding="5,0,6,0" Margin="0,0,0,5" FontSize="11.5"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>

                        <!-- 4) Duraklat / Devam Et -->
                        <Button x:Name="BtnPauseResume" Click="OnPauseResumeClick" Height="34"
                                Padding="5,0,6,0" FontSize="11.5"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== SAĞ İÇERİK ALANI ==================== -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="PageLayouts" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <ContentControl x:Name="HostLayouts"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageVirtual" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostVirtual"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageWorkspaces" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostWorkspaces"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostHotkeys"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostSettings"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageHelp" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostHelp"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
