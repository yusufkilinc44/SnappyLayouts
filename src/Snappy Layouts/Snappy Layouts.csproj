<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>SnappyLayout</RootNamespace>
    <AssemblyName>Snappy Layouts</AssemblyName>

    <!-- ===== VERSION: her değişiklikte artırılır (v0.1 → v0.2 → ... → v1.0 canlı) ===== -->
    <Version>0.25.0</Version>
    <AssemblyVersion>0.25.0.0</AssemblyVersion>
    <FileVersion>0.25.0.0</FileVersion>
    <InformationalVersion>0.25</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Product>Snappy Layouts</Product>
    <Company>YUSUF KILINÇ</Company>
    <Authors>YUSUF KILINÇ</Authors>
    <Copyright>© YUSUF KILINÇ — Kasım 2026</Copyright>
    <Description>Snappy Layouts — Customizable Snap Layouts and Virtual Monitors for Windows</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);CA1416;WPF0001;CS8632;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
