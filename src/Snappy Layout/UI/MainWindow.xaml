<Window x:Class="SnappyLayout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snappy Layout"
        Width="1220" Height="820"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SOL KENAR ÇUBUĞU (COLLAPSIBLE SIDEBAR) ==================== -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Başlık + Versiyon + Collapse Düğmesi -->
                <Grid Grid.Row="0" Margin="2,2,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                            Background="{DynamicResource BrandGradientBrush}"
                            Cursor="Hand" MouseLeftButtonDown="OnToggleSidebarClick"
                            ToolTip="Toggle Sidebar">
                        <TextBlock Text="⊞" FontSize="21" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="SidebarBrandText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Snappy Layout" FontSize="17.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource NavWorkspacesBgBrush}"
                                    BorderBrush="{DynamicResource NavWorkspacesBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarVersionText" Text="v0.1" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource NavWorkspacesBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SidebarStatusText" Text="Active" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PermanentBrush}"/>
                    </StackPanel>

                    <Button x:Name="BtnToggleSidebar" Grid.Column="2" Content="☰" Click="OnToggleSidebarClick"
                            Padding="6,4" FontSize="13" VerticalAlignment="Center" ToolTip="Collapse / Expand Menu"/>
                </Grid>

                <!-- Sekme Düğmeleri (Her biri kendi canlı renkli ikon rozetiyle) -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" x:Name="NavButtonsPanel">
                    <Button x:Name="BtnNavLayouts" Click="OnNavClick" Tag="0"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavVirtual" Click="OnNavClick" Tag="1"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavWorkspaces" Click="OnNavClick" Tag="2"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavHotkeys" Click="OnNavClick" Tag="3"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavSettings" Click="OnNavClick" Tag="4"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                    <Button x:Name="BtnNavHelp" Click="OnNavClick" Tag="5"
                            HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" FontSize="13"/>
                </StackPanel>

                <!-- Genişletilmiş Mod Alt Kontroller -->
                <Border x:Name="SidebarFooterExpanded" Grid.Row="3"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <ComboBox Grid.Column="1" x:Name="QuickLangCombo" SelectionChanged="OnQuickLangChanged" FontSize="11.5" Padding="6,3"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎨" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <ComboBox Grid.Column="1" x:Name="QuickThemeCombo" SelectionChanged="OnQuickThemeChanged" FontSize="11.5" Padding="6,3"/>
                        </Grid>
                        <Button x:Name="BtnQuickShowBorders" Click="OnQuickShowBorders"
                                Padding="8,6" Margin="0,0,0,5" FontSize="11.5" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BtnPauseResume" Click="OnPauseResumeClick"
                                Padding="8,6" FontSize="11.5" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Daraltılmış (Collapse) Mod Alt İkon Kontrolleri -->
                <StackPanel x:Name="SidebarFooterCompact" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Button x:Name="BtnCompactBorders" Click="OnQuickShowBorders" Content="◫"
                            Width="44" Height="36" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"
                            Foreground="{DynamicResource NavVirtualBrush}"
                            Background="{DynamicResource NavVirtualBgBrush}"
                            BorderBrush="{DynamicResource NavVirtualBrush}"/>
                    <Button x:Name="BtnCompactPause" Click="OnPauseResumeClick" Content="⏸"
                            Width="44" Height="36" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"
                            Foreground="{DynamicResource NavHotkeysBrush}"
                            Background="{DynamicResource NavHotkeysBgBrush}"
                            BorderBrush="{DynamicResource NavHotkeysBrush}"/>
                    <Button Click="OnToggleSidebarClick" Content="»" ToolTip="Expand Sidebar"
                            Width="44" Height="32" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== SAĞ İÇERİK ALANI ==================== -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="PageLayouts" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <ContentControl x:Name="HostLayouts"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageVirtual" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostVirtual"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageWorkspaces" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostWorkspaces"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostHotkeys"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostSettings"/>
            </ScrollViewer>

            <ScrollViewer x:Name="PageHelp" VerticalScrollBarVisibility="Auto" Padding="22,18" Visibility="Collapsed">
                <ContentControl x:Name="HostHelp"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
