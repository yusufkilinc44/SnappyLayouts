<Window x:Class="SnappyLayout.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snappy Layout — YUSUF KILINÇ (Kasım 2026)"
        Width="1220" Height="820"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SOL KENAR ÇUBUĞU (SIDEBAR) ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Başlık + Versiyon -->
                <StackPanel Grid.Row="0" Margin="4,4,4,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="9"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⊞" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Snappy Layout" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="{DynamicResource AccentSubtleBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="5"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarVersionText" Text="v0.1" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SidebarStatusText" Text="Aktif" FontSize="11.5"
                                       Foreground="{DynamicResource PermanentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Yazar İmza Kartı: YUSUF KILINÇ Kasım 2026 -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="YUSUF KILINÇ" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Kasım 2026  •  Windows Snap &amp; Virtual Display"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Sekme Düğmeleri -->
                <StackPanel Grid.Row="2" x:Name="NavButtonsPanel">
                    <Button x:Name="BtnNavLayouts" Click="OnNavClick" Tag="0"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                    <Button x:Name="BtnNavVirtual" Click="OnNavClick" Tag="1"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                    <Button x:Name="BtnNavWorkspaces" Click="OnNavClick" Tag="2"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                    <Button x:Name="BtnNavHotkeys" Click="OnNavClick" Tag="3"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                    <Button x:Name="BtnNavSettings" Click="OnNavClick" Tag="4"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                    <Button x:Name="BtnNavHelp" Click="OnNavClick" Tag="5"
                            HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,5" FontSize="13"/>
                </StackPanel>

                <!-- Hızlı Dil / Tema / Test Kontrolleri -->
                <Border Grid.Row="3"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <ComboBox Grid.Column="1" x:Name="QuickLangCombo" SelectionChanged="OnQuickLangChanged" FontSize="11.5" Padding="6,3"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎨" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <ComboBox Grid.Column="1" x:Name="QuickThemeCombo" SelectionChanged="OnQuickThemeChanged" FontSize="11.5" Padding="6,3"/>
                        </Grid>
                        <Button x:Name="BtnQuickShowBorders" Click="OnQuickShowBorders"
                                Padding="8,6" Margin="0,0,0,5" FontSize="11.5" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BtnPauseResume" Click="OnPauseResumeClick"
                                Padding="8,6" FontSize="11.5" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== SAĞ İÇERİK ALANI ==================== -->
        <Grid Grid.Column="1">
            <!-- Sayfa 0: Yerleşim Düzenleri -->
            <ScrollViewer x:Name="PageLayouts" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <ContentControl x:Name="HostLayouts"/>
            </ScrollViewer>

            <!-- Sayfa 1: Sanal Monitörler -->
            <ScrollViewer x:Name="PageVirtual" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <ContentControl x:Name="HostVirtual"/>
            </ScrollViewer>

            <!-- Sayfa 2: Çalışma Alanları -->
            <ScrollViewer x:Name="PageWorkspaces" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <ContentControl x:Name="HostWorkspaces"/>
            </ScrollViewer>

            <!-- Sayfa 3: Kısayol Tuşları -->
            <ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <ContentControl x:Name="HostHotkeys"/>
            </ScrollViewer>

            <!-- Sayfa 4: Ayarlar & DPI -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <ContentControl x:Name="HostSettings"/>
            </ScrollViewer>

            <!-- Sayfa 5: Yardım & Hakkında -->
            <ScrollViewer x:Name="PageHelp" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <ContentControl x:Name="HostHelp"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
